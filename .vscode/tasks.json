{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Program Files (x86)\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-I",
                "${workspaceFolder}\\backend\\include",
                "-lws2_32",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build C++ Backend",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}\\backend\\src\\main.cpp",
                "-I",
                "${workspaceFolder}\\backend\\include",
                "-lws2_32",
                "-o",
                "${workspaceFolder}\\build\\backend.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "C++ Backend",
            "type": "shell",
            "command": ".\\backend.exe",
            "options": {
                "cwd": "${workspaceFolder}\\build"
            },
            "dependsOn": [
                "Build C++ Backend"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "panel": "dedicated",
                "group": "servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Node Server",
            "type": "shell",
            "command": "node server.js",
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "presentation": {
                "panel": "dedicated",
                "group": "servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Vite Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "presentation": {
                "panel": "dedicated",
                "group": "servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Start All Servers",
            "dependsOn": [
                "C++ Backend",
                "Node Server",
                "Vite Frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}